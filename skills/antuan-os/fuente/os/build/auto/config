#!/bin/sh
# Configuracion de la imagen Antuan OS
set -e
lb config noauto \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures amd64 \
  --linux-flavours amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi grub-pc" \
  --debian-installer none \
  --firmware-binary true \
  --firmware-chroot true \
  --iso-application "Antuan" \
  --iso-publisher "Antuan" \
  --iso-volume "ANTUAN" \
  --image-name "umbra" \
  --bootappend-live "boot=live components quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 username=umbra hostname=antuan locales=es_ES.UTF-8 keyboard-layouts=es" \
  --apt-recommends false \
  --security true \
  --updates true \
  --backports true \
  "${@}"
