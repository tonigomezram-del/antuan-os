#!/bin/sh
# Captura de pantalla Antuan: selecciona una zona, se guarda en Imagenes/Capturas y se copia al portapapeles
dir="$(xdg-user-dir PICTURES)/Capturas"
mkdir -p "$dir"
f="$dir/Captura $(date +'%Y-%m-%d %H%M%S').png"
if maim -s -u "$f"; then
  xclip -selection clipboard -t image/png -i "$f"
  /opt/umbra/umbra --ui="toast:image:Captura guardada"
fi
