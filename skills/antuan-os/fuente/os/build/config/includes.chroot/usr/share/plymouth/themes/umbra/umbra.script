# Arranque Antuan: fondo negro, el logo aparece suave y un anillo respira mientras carga.
Window.SetBackgroundTopColor(0.016, 0.02, 0.024);
Window.SetBackgroundBottomColor(0.016, 0.02, 0.024);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20;
logo.sprite.SetPosition(logo.x, logo.y, 1);
logo.sprite.SetOpacity(0);

word.image = Image("palabra.png");
word.sprite = Sprite(word.image);
word.sprite.SetPosition(Window.GetWidth() / 2 - word.image.GetWidth() / 2, logo.y + logo.image.GetHeight() + 28, 1);
word.sprite.SetOpacity(0);

t = 0;
fun refresh() {
  t++;
  a = t / 60;
  if (a > 1) a = 1;
  logo.sprite.SetOpacity(a);
  b = (t - 30) / 60;
  if (b < 0) b = 0;
  if (b > 1) b = 1;
  word.sprite.SetOpacity(b * (0.75 + 0.25 * Math.Sin(t / 25)));
}
Plymouth.SetRefreshFunction(refresh);

# Contrasena de disco cifrado, si la hay
fun display_password(prompt, bullets) {
  msg.image = Image.Text("Contraseña · " + bullets, 0.91, 0.92, 0.95);
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetPosition(Window.GetWidth() / 2 - msg.image.GetWidth() / 2, Window.GetHeight() * 0.75, 2);
}
Plymouth.SetDisplayPasswordFunction(display_password);
