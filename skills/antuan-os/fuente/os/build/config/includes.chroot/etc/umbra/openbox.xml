<?xml version="1.0" encoding="UTF-8"?>
<!-- Ventanas Antuan: tema propio, botones a la derecha, atajos del escritorio Antuan -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Umbra</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>yes</animateIconify>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>Bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>Normal</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
  </theme>
  <placement><policy>Smart</policy><center>yes</center></placement>
  <desktops><number>1</number></desktops>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <keyboard>
    <keybind key="Super_L"><action name="Execute"><command>umbra-cmd toggle-launcher</command></action></keybind>
    <keybind key="W-s"><action name="Execute"><command>umbra-cmd spotlight</command></action></keybind>
    <keybind key="W-Tab"><action name="Execute"><command>umbra-cmd mission</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>umbra-archivos</command></action></keybind>
    <keybind key="W-Up"><action name="Maximize"/></keybind>
    <keybind key="W-Down"><action name="Unmaximize"/></keybind>
    <keybind key="W-Left"><action name="UnmaximizeFull"/><action name="MoveResizeTo"><x>0</x><y>0</y><width>50%</width><height>100%</height></action></keybind>
    <keybind key="W-Right"><action name="UnmaximizeFull"/><action name="MoveResizeTo"><x>-0</x><y>0</y><width>50%</width><height>100%</height></action></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"><finalactions><action name="Focus"/><action name="Raise"/></finalactions></action></keybind>
    <keybind key="C-A-Delete"><action name="Execute"><command>umbra-cmd centro:rendimiento</command></action></keybind>
    <keybind key="Print"><action name="Execute"><command>umbra-cmd captura</command></action></keybind>
  </keyboard>
  <mouse>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    </context>
    <context name="Close"><mousebind button="Left" action="Click"><action name="Close"/></mousebind></context>
    <context name="Maximize"><mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind></context>
    <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify"/></mousebind></context>
    <context name="Frame">
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Client"><mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind></context>
  </mouse>
  <applications>
    <application class="Umbra"><decor>no</decor></application>
    <application class="Antuan"><decor>no</decor></application>
  </applications>
</openbox_config>
